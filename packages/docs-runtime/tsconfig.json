// 文档编辑器运行时与页面入口单独检查（README「验证」）。还原代码仍有待收紧的互操作类型，
// 保留原工程的 noUncheckedIndexedAccess 选项与 vite/client。通过包导出统一解析自定义 JSX runtime，
// 使按职责分目录的模块继续保留原始 React 调用语义。
// 根 tsconfig.json 排除这两个目录，npm run typecheck 依次检查两者。
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@baocut/docs-runtime/react-runtime",
    "paths": {
      "#base-ui/*": ["./node_modules/@base-ui/react/*"],
      "#base-ui-utils/*": ["./node_modules/@base-ui/utils/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "../../apps/docs-editor/src/**/*"],
  "exclude": []
}
