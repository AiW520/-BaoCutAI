// 文档编辑器运行时与页面入口单独检查（README「验证」）。还原代码仍有待收紧的互操作类型，
// 保留原工程的 noUncheckedIndexedAccess 选项与 vite/client；TSX 使用 React 标准 JSX runtime。
// 根 tsconfig.json 排除这两个目录，npm run typecheck 依次检查两者。
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "#base-ui/*": ["./node_modules/@base-ui/react/*"],
      "#base-ui-utils/*": ["./node_modules/@base-ui/utils/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "../../apps/docs-editor/src/**/*"],
  "exclude": []
}
