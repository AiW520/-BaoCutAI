// baocut.com：静态页面（dist/，由 `npm run build` 生成）加一个 Worker。
// Worker 只接管下面 run_worker_first 列出的路径：首页按语言跳转、页面里的版本号、/download/* 跳到 GitHub Releases 上的最新版本、/api/release。
// 其余文件（图片、样式、模板预览）由静态资源直接返回。部署见 README.md。
{
  "name": "baocut-portal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/zh-hans", "/zh-hans/", "/zh-hans/index.html", "/download", "/download/*", "/api/*"]
  },
  "routes": [
    { "pattern": "baocut.com", "custom_domain": true },
    { "pattern": "www.baocut.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
